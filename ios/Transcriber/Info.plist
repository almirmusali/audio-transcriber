	<string>Микрофон пишет совещание или заметку. Запись уходит только на твой Mac для расшифровки.</string>
	<key>TranscriberServerURL</key>
	<string>$(TRANSCRIBER_SERVER_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
